{
  "name": "diabetes-emr-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run",
    "test:harness": "vitest --run src/pages/**/__tests__/*.integration.spec.jsx src/components/**/__tests__/*.spec.jsx src/lib/__tests__/*.spec.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "axios": "^1.4.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^2.2.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@solidjs/testing-library": "^0.8.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.0.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^1.2.0"
  },
  "vitest": {
    "test": {
      "environment": "jsdom",
      "globals": true
    }
  }
}
